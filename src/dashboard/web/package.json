{
  "name": "windbot-local-dashboard",
  "version": "0.0.0",
  "description": "Local dashboard served by the windbot, built into ../static",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  }
}
